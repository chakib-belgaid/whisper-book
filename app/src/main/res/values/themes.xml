<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The Compose theme is intentionally dark. Declaring a light platform theme lets
        Android Force Dark recolor Compose draw layers independently, which can invert
        the backdrop and bottom navigation on some devices.
    -->
    <style name="Theme.Whisperbook.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/parchment_light</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Whisperbook" parent="Theme.Whisperbook.Base" />
</resources>
